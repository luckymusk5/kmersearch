# Étape 1 : Build avec Node
FROM node:18 AS build   

WORKDIR /app

# Copier uniquement les fichiers nécessaires pour installer
COPY package*.json ./
RUN npm install

# Copier le reste du projet
COPY . .

# Lancer le build (génère le dossier dist/)
RUN npm run build

# Étape 2 : Nginx pour servir le frontend
FROM nginx:alpine

# Config Nginx (SPA routing)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copier le build généré
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
