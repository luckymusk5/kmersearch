# Étape 1 : Choisir une image Python légère
FROM python:3.11-slim

# Étape 2 : Créer un dossier de travail
WORKDIR /app

# Étape 3 : Copier les fichiers de dépendances
COPY requirements.txt .

# Étape 4 : Installer les dépendances
RUN pip install --no-cache-dir -r requirements.txt

# Étape 5 : Copier le reste du code source
COPY . .

# Étape 6 : Exposer le port Flask
EXPOSE 5000

# Étape 7 : Démarrer l'application Flask
CMD ["python", "kmersearchback.py"]
